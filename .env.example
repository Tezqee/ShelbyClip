# Shelby Protocol API Settings
# VITE_* values are exposed in the browser bundle. Never put private keys,
# seed phrases, wallet passwords, or server-only secrets in this file.
# Get your API key from https://api.shelbynet.shelby.xyz/shelby (or appropriate provider)
VITE_SHELBY_API_KEY=your_api_key_here

# Shelby Gateway Node URLs (ShelbyNet - Dev Prototype Network)
VITE_GATEWAY_URL_1=https://api.shelbynet.shelby.xyz/shelby
VITE_GATEWAY_URL_2=https://shelby.shelbynet.shelby.xyz/shelby
VITE_SHELBY_CONTRACT_ADDRESS=0x9ce0fd7ef60010764b6737ed49e1296fb5e34adad586b8ef33276b3ad67f808e

# Optional: Mainnet configuration (Planned)
# VITE_SHELBY_NETWORK=mainnet
